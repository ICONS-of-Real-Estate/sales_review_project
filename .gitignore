__pycache__/
*.pyc
.pytest_cache/

# Downloaded Python wheels — pip/uv drops these in the CWD when inspecting a
# package. They are build artifacts, never project files (and are not even the
# versions tools/dashboard/requirements.txt pins).
*.whl

# Local OAuth artifacts for tools/transcribe_sean_calls.py — never commit secrets
tools/credentials.json
tools/token.json

# Per-machine progress log from tools/transcribe_tomas_calls*.py — local state, not shared
tools/tomas_transcribed_log.txt

# Per-machine Python virtualenv created by tools/deploy/setup_ovh.sh
tools/.venv/

# Dashboard: service-account key (never commit secrets), local SQLite mirror
# (disposable derived data, rebuilt by sync.py), and its per-machine venv
tools/dashboard/service_account.json
tools/dashboard/dashboard.db
tools/dashboard/.venv/
